# docker/Dockerfile.infer
FROM python:3.11-slim
 
WORKDIR /app
 
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn==0.30.0 \
    torch==2.1.0 \
    pydantic==2.7.0
 
COPY ./src/ /app
 
# SageMaker REQUIRES port 8080
EXPOSE 8080
 
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
